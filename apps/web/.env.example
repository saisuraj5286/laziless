# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Postgres (Supabase). Two different connection strings:
# - Local .env: the DIRECT connection (Supabase > Connect > Direct connection,
#   port 5432). Used by the dev server and by `pnpm db:migrate`. The direct host
#   is IPv6-only; if your network has no IPv6, use the Session pooler instead.
# - Vercel: the TRANSACTION POOLER (Supabase > Connect > Transaction pooler,
#   port 6543). Vercel can't reach IPv6-only hosts.
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres:password@localhost:5432/laziless"

# Public site origin (no trailing slash). Used for canonical URLs, sitemap, OG tags.
# Set this to your real domain in Vercel, or search engines will see localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
