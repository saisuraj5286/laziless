{
  "name": "laziless",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @laziless/web dev",
    "build": "pnpm --filter @laziless/web build",
    "start": "pnpm --filter @laziless/web start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "db:generate": "pnpm --filter @laziless/web db:generate",
    "db:migrate": "pnpm --filter @laziless/web db:migrate",
    "db:studio": "pnpm --filter @laziless/web db:studio"
  },
  "packageManager": "pnpm@10.12.1"
}
